# ── Kalshi ────────────────────────────────────────────────────────────────────
# Environment: "demo" (paper trading) or "prod" (live money)
KALSHI_ENV=demo

# API credentials from https://kalshi.com → Settings → API Keys
# Option A — base64-encoded PEM (recommended for Docker):
#   Linux/Mac:  KALSHI_PEM_B64=$(base64 -w 0 ~/.kalshi/kalshi-demo.pem)
#   Windows PS: KALSHI_PEM_B64=[Convert]::ToBase64String([IO.File]::ReadAllBytes("$HOME\.kalshi\kalshi-demo.pem"))
KALSHI_KEY_ID=your-api-key-uuid-here
KALSHI_PEM_B64=

# Option B — path to PEM file (native installs; leave blank if using Option A)
# KALSHI_PEM_PATH=/home/user/.kalshi/kalshi-demo.pem

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Tavily (optional but recommended) ────────────────────────────────────────
# Improves web search reliability for the Research Agent
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-...

# ── Dashboard access ─────────────────────────────────────────────────────────
# Required for any access other than directly from this machine (e.g. your phone
# over Tailscale). Use a long random password.
# DASHBOARD_PASSWORD=
# Set to false to require the password even on this machine.
# DASHBOARD_TRUST_LOCALHOST=true

# ── Ollama (optional local model) ────────────────────────────────────────────
# Native installs default to http://localhost:11434; Docker defaults to the host.
# OLLAMA_HOST=http://localhost:11434
